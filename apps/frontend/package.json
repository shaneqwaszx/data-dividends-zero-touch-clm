{
  "name": "zero-touch-clm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "e2e": "python ../../scripts/run_e2e.py",
    "e2e:headed": "python ../../scripts/run_e2e.py --headed",
    "e2e:list": "playwright test --list",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "7.1.11",
    "vitest": "3.2.4"
  }
}
