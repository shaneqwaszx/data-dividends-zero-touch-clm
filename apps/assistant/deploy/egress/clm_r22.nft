#!/usr/sbin/nft -f
# R2.2 assistant egress host table (D-129 PROPOSED; E1 LOCAL DESIGN CANDIDATE, not approved for
# AWS). Installed at /etc/clm/r22/clm_r22.nft and loaded ONLY by clm-r22-assistant-firewall.service,
# before Docker. Never nftables.service, ufw, DOCKER-USER or "flush ruleset": the first two lines
# replace this table alone and leave Docker's tables and R3's `inet clm_r3` untouched.
# Values: clm_r22.vars. The filter chains are drop-only: an accept here ends only this chain;
# Docker's chains still run. The only allowed flow: the assistant (172.30.243.2) -> the pinned
# Anthropic IPv4 -> tcp/443.
# P2-1: Docker does not masquerade the bridge (compose.assistant-provider.yml), so this table's
# one NAT rule is the only way the assistant's address leaves the host translated. Without the
# table nothing from clm-as-up is translated and the uplink gives the assistant no internet path.
table inet clm_r22 {}
delete table inet clm_r22
table inet clm_r22 {
  set anthropic_dst_v4 {
    type ipv4_addr
    elements = { 160.79.104.10 }
  }
  chain forward {
    type filter hook forward priority filter - 10; policy accept;
    oifname "clm-as-up" ct state established,related counter accept
    oifname "clm-as-up" counter drop
    iifname "clm-as-up" meta nfproto ipv6 counter drop
    iifname "clm-as-up" ct state invalid counter drop
    iifname "clm-as-up" ip saddr != 172.30.243.2 counter drop
    iifname "clm-as-up" ip saddr 172.30.243.2 ip daddr @anthropic_dst_v4 oifname "ens5" tcp dport 443 counter accept
    iifname "clm-as-up" counter drop
  }
  chain input {
    type filter hook input priority filter - 10; policy accept;
    iifname "clm-as-up" ct state established,related counter accept
    iifname "clm-as-up" counter drop
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 172.30.243.2 ip daddr @anthropic_dst_v4 oifname "ens5" tcp dport 443 counter masquerade
  }
}
