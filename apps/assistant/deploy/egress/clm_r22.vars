# R2.2 assistant egress variables (D-129 PROPOSED, E1 LOCAL DESIGN CANDIDATE). The single
# reviewed source for clm_r22.nft; tests/test_assistant_egress.py asserts the table uses exactly
# these values. A host preflight must assert UPLINK_IF and VPC facts on the live host first.
UPLINK_IF=ens5
UPLINK_BRIDGE=clm-as-up
ASSISTANT_UPLINK_IP=172.30.243.2
ASSISTANT_CONTAINER=clm-staging-assistant
# The pin: must equal ASSISTANT_ANTHROPIC_PINNED_V4 in compose.env and lie inside Anthropic's
# published inbound IPv4 ranges (160.79.104.0/23, 153.61.224.0/22). Workstation observation
# 2026-11-13 (3 samples): api.anthropic.com A 160.79.104.10. The host preflight re-resolves it
# through the VPC resolver and stops on any difference.
ANTHROPIC_DST_V4=160.79.104.10
