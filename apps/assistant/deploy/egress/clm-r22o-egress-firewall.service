# Hosted GPT-OSS egress host table (D-138 A1 PROPOSED, LOCAL DESIGN CANDIDATE). Install:
# /etc/systemd/system/. Loads ONLY `table inet clm_r22o`, before Docker. Stopping this unit stops
# the egress proxy and resolver BEFORE the table is removed, so the uplink is never open without it.
[Unit]
Description=CLM hosted GPT-OSS egress host table (inet clm_r22o)
DefaultDependencies=no
After=local-fs.target
Before=docker.service network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/clm/r22o/clm_r22o.nft
ExecStop=/usr/local/lib/clm-r22o/clm_r22o_stop_egress.sh firewall-stop
ExecStop=/usr/sbin/nft delete table inet clm_r22o

[Install]
WantedBy=multi-user.target
