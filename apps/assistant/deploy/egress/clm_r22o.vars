# Hosted GPT-OSS egress variables (D-138 A1, PROPOSED; LOCAL DESIGN CANDIDATE). The single
# reviewed source for clm_r22o.nft; tests/test_openrouter_egress.py asserts the table uses
# exactly these values. A host preflight must assert UPLINK_IF, VPC_RESOLVER_IP and that both
# subnets (172.30.244.0/29, 172.30.245.0/29) are free on the live host first.
UPLINK_IF=ens5
UPLINK_BRIDGE=clm-ao-up
CONTROL_BRIDGE=clm-ao-ctl
PROXY_UPLINK_IP=172.30.245.2
RESOLVER_UPLINK_IP=172.30.245.3
VPC_RESOLVER_IP=172.26.0.2
R22O_CONTAINERS=clm-staging-openrouter-egress,clm-staging-openrouter-dns
# There is deliberately no destination pin: OpenRouter publishes no fixed inbound range. The
# proxy may reach tcp/443 on a public IPv4; the exact-host gate decides the host (README).
