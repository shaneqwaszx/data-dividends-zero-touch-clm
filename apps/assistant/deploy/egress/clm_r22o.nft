#!/usr/sbin/nft -f
# Hosted GPT-OSS egress host table (D-138 A1, PROPOSED; LOCAL DESIGN CANDIDATE, not approved
# for AWS). Installed at /etc/clm/r22o/clm_r22o.nft and loaded ONLY by
# clm-r22o-egress-firewall.service, before Docker. Never nftables.service, ufw, DOCKER-USER or
# "flush ruleset": the first two lines replace this table alone and leave Docker's tables, R3's
# `inet clm_r3` and E1's `inet clm_r22` untouched. Values: clm_r22o.vars. The filter chains are
# drop-only: an accept here ends only this chain; Docker's chains still run.
# The only flows: the proxy (172.30.245.2) -> a public IPv4 -> tcp/443, and the resolver
# (172.30.245.3) -> the VPC resolver -> 53. The internal control bridge forwards nothing, so the
# assistant's only way out is CONNECT openrouter.ai:443 through the proxy.
# P2-1 (as E1): Docker does not masquerade clm-ao-up (compose.assistant-openrouter.yml), so this
# table's NAT rules are the only translation. Without the table nothing from clm-ao-up leaves
# the host translated, and the proxy has no internet path (fail closed).
table inet clm_r22o {}
delete table inet clm_r22o
table inet clm_r22o {
  set no_egress_v4 {
    type ipv4_addr
    flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
                 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16,
                 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
  }
  chain forward {
    type filter hook forward priority filter - 10; policy accept;
    iifname "clm-ao-ctl" counter drop
    oifname "clm-ao-ctl" counter drop
    oifname "clm-ao-up" ct state established,related counter accept
    oifname "clm-ao-up" counter drop
    iifname "clm-ao-up" meta nfproto ipv6 counter drop
    iifname "clm-ao-up" ct state invalid counter drop
    iifname "clm-ao-up" ip saddr != { 172.30.245.2, 172.30.245.3 } counter drop
    iifname "clm-ao-up" ip saddr 172.30.245.3 ip daddr 172.26.0.2 meta l4proto { udp, tcp } th dport 53 oifname "ens5" counter accept
    iifname "clm-ao-up" ip saddr 172.30.245.3 counter drop
    iifname "clm-ao-up" ip daddr @no_egress_v4 counter drop
    iifname "clm-ao-up" ip saddr 172.30.245.2 oifname "ens5" tcp dport 443 counter accept
    iifname "clm-ao-up" counter drop
  }
  chain input {
    type filter hook input priority filter - 10; policy accept;
    iifname { "clm-ao-up", "clm-ao-ctl" } ct state established,related counter accept
    iifname { "clm-ao-up", "clm-ao-ctl" } counter drop
  }
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr 172.30.245.2 ip daddr != @no_egress_v4 oifname "ens5" tcp dport 443 counter masquerade
    ip saddr 172.30.245.3 ip daddr 172.26.0.2 oifname "ens5" meta l4proto { udp, tcp } th dport 53 counter masquerade
  }
}
