# Copy to apps/assistant/.env to override. All values are optional.
AI_ASSISTANT_CLM_BACKEND_URL=http://127.0.0.1:8000
AI_ASSISTANT_LLM_ENABLED=true
AI_ASSISTANT_LLM_BASE_URL=http://127.0.0.1:11434/v1
AI_ASSISTANT_LLM_MODEL=ministral-3:8b
# Ollama ignores the key; a cloud provider needs a real one (never commit it).
AI_ASSISTANT_LLM_API_KEY=ollama
# Safety limit on answer length (tokens); a normal answer is far shorter.
AI_ASSISTANT_LLM_MAX_ANSWER_TOKENS=600
# Optional local case-fact warm-up: literal loopback IP only, no proxy or redirects.
# This flag cannot enable remote warm-up or approve deployment data handling.
AI_ASSISTANT_LLM_WARM_UP=true
# Reviewed knowledge base (SQLite + ChromaDB, local; path relative to apps/assistant).
AI_ASSISTANT_KNOWLEDGE_DATA_DIR=data/knowledge
# POC only (D-083, proposed): one reviewer may publish an entry they wrote, after confirming;
# recorded as single-reviewer. false keeps two-person review.
AI_ASSISTANT_KNOWLEDGE_SINGLE_REVIEWER=true
# Answer records (D-084, proposed): days to keep a record not linked to an enhancement
# request (unrated or "Yes, helpful"), and days to keep a linked one after its request
# was resolved or closed.
AI_ASSISTANT_ANSWER_RECORD_UNRATED_DAYS=7
AI_ASSISTANT_ANSWER_RECORD_CLOSED_DAYS=30
AI_ASSISTANT_EMBED_BASE_URL=http://127.0.0.1:11434
AI_ASSISTANT_EMBED_MODEL=nomic-embed-text
# Content-free metrics per answer (counts, sizes, timings, codes only): off or log.
AI_ASSISTANT_TELEMETRY=off
# Model profile (D-091, proposed). The default is the local adapter above, unchanged. The
# remote profile openrouter_gpt_oss_120b is DORMANT in this build: it refuses to start against
# a real network whatever is set here. Its key is read only from the process environment
# (variable OPENROUTER_API_KEY), never from this file: do not add it here.
AI_ASSISTANT_LLM_PROFILE=local_openai_compatible
AI_ASSISTANT_REMOTE_INFERENCE_DECISION=
# Phase B (D-092, proposed): only the evaluation harness can open the live gate, for its
# synthetic fixture cases; the service never does, whatever is set here.
AI_ASSISTANT_REMOTE_LIVE_DECISION=
AI_ASSISTANT_OPENROUTER_ENDPOINT=
AI_ASSISTANT_LLM_REASONING_EFFORT=
AI_ASSISTANT_LLM_REASONING_ALLOWANCE_TOKENS=0
AI_ASSISTANT_REMOTE_MAX_PROMPT_BYTES=32768
# Remote profile only: the lifetime budget ledger (relative to apps/assistant, not in Git).
# The cap lives in the ledger (scripts/budget_ledger.py), never here.
AI_ASSISTANT_BUDGET_LEDGER_PATH=data/budget/ledger.sqlite3
AI_ASSISTANT_BUDGET_MAX_IN_FLIGHT=1
AI_ASSISTANT_BUDGET_SETTLE_LAG_SECONDS=600
# Model management (D-093; local loopback models only). Off while the file is not named.
# IT writes the profiles file (see model_profiles.example.json and
# docs/integration/AI_MODEL_CONFIGURATION.md); an HR administrator chooses among them in the CLM.
# Profile keys go only in the process environment, as AI_ASSISTANT_MODEL_KEY_OLLAMA,
# AI_ASSISTANT_MODEL_KEY_LM_STUDIO, AI_ASSISTANT_MODEL_KEY_VLLM or AI_ASSISTANT_MODEL_KEY_LOCAL;
# never in this file or the profiles file.
AI_ASSISTANT_MODEL_PROFILES_FILE=
AI_ASSISTANT_MODEL_ADMIN_DB_PATH=data/models/model_admin.sqlite3
AI_ASSISTANT_MODEL_QUALIFICATION_MAX_SECONDS=3600
