# Copy to apps/assistant/.env to override. All values are optional.
COPILOT_CLM_BACKEND_URL=http://127.0.0.1:8000
COPILOT_LLM_ENABLED=true
COPILOT_LLM_BASE_URL=http://127.0.0.1:11434/v1
COPILOT_LLM_MODEL=ministral-3:8b
# Ollama ignores the key; a cloud provider needs a real one (never commit it).
COPILOT_LLM_API_KEY=ollama
