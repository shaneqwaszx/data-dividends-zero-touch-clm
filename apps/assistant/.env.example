# Copy to apps/assistant/.env to override. All values are optional.
AI_ASSISTANT_CLM_BACKEND_URL=http://127.0.0.1:8000
AI_ASSISTANT_LLM_ENABLED=true
AI_ASSISTANT_LLM_BASE_URL=http://127.0.0.1:11434/v1
AI_ASSISTANT_LLM_MODEL=ministral-3:8b
# Ollama ignores the key; a cloud provider needs a real one (never commit it).
AI_ASSISTANT_LLM_API_KEY=ollama
# Safety limit on answer length (tokens); a normal answer is far shorter.
AI_ASSISTANT_LLM_MAX_ANSWER_TOKENS=600
# Read the rules and case facts in the background when the panel opens.
AI_ASSISTANT_LLM_WARM_UP=true
# Reviewed knowledge base (SQLite + ChromaDB, local; path relative to apps/assistant).
AI_ASSISTANT_KNOWLEDGE_DATA_DIR=data/knowledge
AI_ASSISTANT_EMBED_BASE_URL=http://127.0.0.1:11434
AI_ASSISTANT_EMBED_MODEL=nomic-embed-text
