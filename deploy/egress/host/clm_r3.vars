# R3 host enforcement variables (D-127 E4). The single reviewed source for clm_r3.nft.
# Values come from R3_SECURITY_HOST_FACTS.md (2026-11-12) and the G1 path table; G3a preflight
# must assert each one against the live host before installation. clm_r3.nft must use exactly
# these values; tests/deploy/test_goldtier_egress_guard.py asserts it.
UPLINK_IF=ens5
UPLINK_BRIDGE=clm-gt-up
CONTROL_BRIDGE=clm-gt-ctl
PROXY_UPLINK_IP=172.30.242.2
RESOLVER_UPLINK_IP=172.30.242.3
VPC_RESOLVER_IP=172.26.0.2
R3_CONTAINERS=clm-staging-goldtier-egress clm-staging-goldtier-dns
# R-1 pin: observed A set for the GoldTier FQDN (fast-track evidence dns-sample-*.txt); preflight
# must re-resolve it on the host through VPC_RESOLVER_IP and stop on any difference.
GOLDTIER_DST_V4=13.42.220.164,18.135.200.6
