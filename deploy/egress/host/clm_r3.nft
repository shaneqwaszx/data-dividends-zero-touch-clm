#!/usr/sbin/nft -f
# R3 host egress table (D-127 E4, G1 review section 2.2). Installed at /etc/clm/r3/clm_r3.nft and
# loaded ONLY by clm-r3-egress-firewall.service. Never through nftables.service, ufw or
# DOCKER-USER, and never with "flush ruleset": the first two lines replace this table alone,
# atomically, and leave Docker's ip/ip6 tables untouched (FA-17).
# Values: clm_r3.vars. Drop-only: an accept here ends only this chain, Docker's chains still run.
table inet clm_r3 {}
delete table inet clm_r3
table inet clm_r3 {
  set no_egress_v4 {
    type ipv4_addr
    flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
                 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16,
                 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }
  }
  # R-1 pin (fast-track A2): the ONLY O-1 destinations. Must equal GOLDTIER_DST_V4 in clm_r3.vars
  # and CLM_GOLDTIER_EGRESS_DST_V4 in compose.env. Never widened to "any public IPv4".
  set goldtier_dst_v4 {
    type ipv4_addr
    elements = { 13.42.220.164, 18.135.200.6 }
  }
  chain forward {
    type filter hook forward priority filter - 10; policy accept;
    iifname "clm-gt-ctl" counter drop
    oifname "clm-gt-ctl" counter drop
    oifname "clm-gt-up" ct state established,related counter accept
    oifname "clm-gt-up" counter drop
    iifname "clm-gt-up" meta nfproto ipv6 counter drop
    iifname "clm-gt-up" ct state invalid counter drop
    iifname "clm-gt-up" ip saddr != { 172.30.242.2, 172.30.242.3 } counter drop
    iifname "clm-gt-up" ip saddr 172.30.242.3 ip daddr 172.26.0.2 meta l4proto { udp, tcp } th dport 53 oifname "ens5" counter accept
    iifname "clm-gt-up" ip saddr 172.30.242.3 counter drop
    iifname "clm-gt-up" ip daddr @no_egress_v4 counter drop
    iifname "clm-gt-up" ip saddr 172.30.242.2 ip daddr @goldtier_dst_v4 oifname "ens5" tcp dport 443 counter accept
    iifname "clm-gt-up" counter drop
  }
  chain input {
    type filter hook input priority filter - 10; policy accept;
    iifname { "clm-gt-up", "clm-gt-ctl" } ct state established,related counter accept
    iifname { "clm-gt-up", "clm-gt-ctl" } counter drop
  }
}
