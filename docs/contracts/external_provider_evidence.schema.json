{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/data-dividends/external-provider-evidence.schema.json",
  "title": "Sanitized external provider evidence",
  "description": "Network-free, credential-free evidence profile for an authorized provider observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "mode",
    "classification",
    "operation",
    "observed_at",
    "safe_test_case_reference",
    "correlation_identifier",
    "http_outcome_category",
    "contract_reference",
    "certificate_verification_result",
    "auth_mechanism_label",
    "mapping_reference",
    "sanitized_result_category",
    "call_order_result",
    "redaction_check_result"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "provider_id": {
      "type": "string",
      "enum": [
        "ACRA_MOCK",
        "ACRA_GENERIC_SANDBOX",
        "ACRA_BIZFILE",
        "IDP_LOCAL_PDF_TEXT",
        "VENDOR_IDP_FUTURE",
        "OWNERSHIP_LOCAL_ENGINE",
        "OWNERSHIP_HIERARCHY_FUTURE",
        "GOLDTIER_MOCK",
        "GOLDTIER_XPI",
        "GOLDTIER_REAL",
        "PINGFED_AUTH"
      ]
    },
    "mode": {"type": "string", "enum": ["mock", "local", "sandbox", "live"]},
    "classification": {
      "type": "string",
      "enum": ["MOCK", "LOCAL", "PARTIAL", "DORMANT", "NOT_IMPLEMENTED", "SANDBOX_VERIFIED", "LIVE_VERIFIED"]
    },
    "operation": {
      "type": "string",
      "enum": [
        "entity_profile",
        "officers",
        "ownership_parties",
        "relationships",
        "extract_document",
        "analyze_ownership",
        "search_party",
        "create_shell_customer",
        "create_policy",
        "amend_party",
        "create_related_party",
        "retrieve_party",
        "get_policy",
        "request_access_token"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?![\\s\\S]*[\\r\\n])(?:(?:(?!0000)[0-9]{4})-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00))-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "safe_test_case_reference": {"type": "string", "pattern": "^(?![\\s\\S]*[\\r\\n])(?:SYNTHETIC|AUTHORIZED)-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "correlation_identifier": {"type": "string", "pattern": "^(?![\\s\\S]*[\\r\\n])[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "http_outcome_category": {
      "type": "string",
      "enum": ["SUCCESS", "NOT_FOUND", "PARTIAL", "AUTH_FAILURE", "TIMEOUT", "VALIDATION_FAILURE", "SERVER_FAILURE", "NOT_APPLICABLE"]
    },
    "contract_reference": {
      "type": "string",
      "enum": [
        "Q-001", "Q-002", "Q-003", "Q-004", "Q-005", "Q-006",
        "Q-007", "Q-008", "Q-009", "Q-010", "Q-011", "Q-012",
        "Q-013", "Q-014", "Q-015", "Q-016", "Q-017", "Q-018",
        "D-009", "D-018", "EXTERNAL_PROVIDER_ACTIVATION_CONTRACT"
      ]
    },
    "certificate_verification_result": {"type": "string", "enum": ["VERIFIED", "NOT_APPLICABLE", "NOT_RUN"]},
    "auth_mechanism_label": {"type": "string", "enum": ["NONE", "BACKEND_INJECTED", "OAUTH2_BEARER", "MTLS", "NOT_APPLICABLE"]},
    "mapping_reference": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "ACRA_CANONICAL_MAPPING",
        "IDP_CANONICAL_MAPPING",
        "OWNERSHIP_CANONICAL_MAPPING",
        "GOLDTIER_CANONICAL_MAPPING"
      ]
    },
    "sanitized_result_category": {
      "type": "string",
      "enum": ["EXPECTED_SUCCESS", "EXPECTED_NOT_FOUND", "EXPECTED_PARTIAL", "EXPECTED_FAILURE", "STOPPED_FAIL_CLOSED", "NOT_APPLICABLE"]
    },
    "call_order_result": {"type": "string", "enum": ["EXPECTED", "STOPPED_ON_FAILURE", "NOT_APPLICABLE"]},
    "redaction_check_result": {"type": "string", "const": "PASS"}
  },
  "oneOf": [
    {
      "properties": {
        "provider_id": {"const": "ACRA_MOCK"},
        "mode": {"enum": ["mock"]},
        "classification": {"enum": ["MOCK"]},
        "operation": {"enum": ["entity_profile", "officers", "ownership_parties", "relationships"]},
        "safe_test_case_reference": {"pattern": "^(?![\\s\\S]*[\\r\\n])SYNTHETIC-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "http_outcome_category": {"enum": ["NOT_APPLICABLE"]},
        "contract_reference": {"enum": ["EXTERNAL_PROVIDER_ACTIVATION_CONTRACT"]},
        "certificate_verification_result": {"enum": ["NOT_APPLICABLE"]},
        "auth_mechanism_label": {"enum": ["NONE"]},
        "mapping_reference": {"enum": ["ACRA_CANONICAL_MAPPING"]},
        "call_order_result": {"enum": ["EXPECTED", "STOPPED_ON_FAILURE"]}
      }
    },
    {
      "properties": {
        "provider_id": {"const": "IDP_LOCAL_PDF_TEXT"},
        "mode": {"enum": ["local"]},
        "classification": {"enum": ["LOCAL"]},
        "operation": {"enum": ["extract_document"]},
        "safe_test_case_reference": {"pattern": "^(?![\\s\\S]*[\\r\\n])SYNTHETIC-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "http_outcome_category": {"enum": ["NOT_APPLICABLE"]},
        "contract_reference": {"enum": ["EXTERNAL_PROVIDER_ACTIVATION_CONTRACT"]},
        "certificate_verification_result": {"enum": ["NOT_APPLICABLE"]},
        "auth_mechanism_label": {"enum": ["NONE"]},
        "mapping_reference": {"enum": ["IDP_CANONICAL_MAPPING"]},
        "call_order_result": {"enum": ["NOT_APPLICABLE"]}
      }
    },
    {
      "properties": {
        "provider_id": {"const": "OWNERSHIP_LOCAL_ENGINE"},
        "mode": {"enum": ["local"]},
        "classification": {"enum": ["LOCAL"]},
        "operation": {"enum": ["analyze_ownership"]},
        "safe_test_case_reference": {"pattern": "^(?![\\s\\S]*[\\r\\n])SYNTHETIC-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "http_outcome_category": {"enum": ["NOT_APPLICABLE"]},
        "contract_reference": {"enum": ["EXTERNAL_PROVIDER_ACTIVATION_CONTRACT"]},
        "certificate_verification_result": {"enum": ["NOT_APPLICABLE"]},
        "auth_mechanism_label": {"enum": ["NONE"]},
        "mapping_reference": {"enum": ["OWNERSHIP_CANONICAL_MAPPING"]},
        "call_order_result": {"enum": ["NOT_APPLICABLE"]}
      }
    },
    {
      "properties": {
        "provider_id": {"const": "GOLDTIER_MOCK"},
        "mode": {"enum": ["mock"]},
        "classification": {"enum": ["MOCK"]},
        "operation": {"enum": ["search_party", "create_shell_customer", "create_policy", "amend_party"]},
        "safe_test_case_reference": {"pattern": "^(?![\\s\\S]*[\\r\\n])SYNTHETIC-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "http_outcome_category": {"enum": ["NOT_APPLICABLE"]},
        "contract_reference": {"enum": ["EXTERNAL_PROVIDER_ACTIVATION_CONTRACT"]},
        "certificate_verification_result": {"enum": ["NOT_APPLICABLE"]},
        "auth_mechanism_label": {"enum": ["NONE"]},
        "mapping_reference": {"enum": ["GOLDTIER_CANONICAL_MAPPING"]},
        "call_order_result": {"enum": ["EXPECTED", "STOPPED_ON_FAILURE"]}
      }
    }
  ]
}
