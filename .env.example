# Application
APP_NAME=Zero-Touch CLM API
APP_ENV=development
DEMO_CONTROLS_ENABLED=false
VITE_DEMO_CONTROLS_ENABLED=false
ZERO_TOUCH_MAX_TRANSITIONS_PER_RUN=12
PHASE13_BROWSER_ORIGIN=http://127.0.0.1:8000

# Persistence is explicit. Memory is process-local; mongo fails closed when unavailable.
CLM_PERSISTENCE_MODE=memory
MONGO_URI=
MONGO_DATABASE=clm_poc
MONGO_CASE_COLLECTION=clm_case_snapshots
MONGO_REGISTRY_CACHE_COLLECTION=clm_registry_snapshots

# Ordinary non-production Mock lanes reuse fresh normalized database evidence.
# Explicit disabled overrides reuse; legacy mock requires exactly 7776000 below.
REGISTRY_CACHE_MODE=auto
REGISTRY_CACHE_FRESHNESS_SECONDS=7776000

# Optional sponsor GoldTier XPI sandbox lane. Mock remains the default. Keep the
# backend-only user_id value out of source, logs, browser state, and documentation.
GOLDTIER_SANDBOX_BASE_URL=
GOLDTIER_SANDBOX_ENVIRONMENT=
GOLDTIER_SANDBOX_USER_ID=
GOLDTIER_SANDBOX_TIMEOUT_SECONDS=10
GOLDTIER_SANDBOX_MAX_RESPONSE_BYTES=131072
GOLDTIER_SANDBOX_ALLOW_WRITES=false

# Future PingFed/production placeholders — still not consumed by composition.
GOLDTIER_BASE_URL=
PINGFED_TOKEN_URL=
GOLDTIER_CLIENT_ID=
GOLDTIER_CLIENT_SECRET=
GOLDTIER_SCOPE=

# ACRA - configure only from authorised subscriber documentation/access
ACRA_BASE_URL=
ACRA_COMPANY_PATH_TEMPLATE=
ACRA_TIMEOUT_SECONDS=10
# Generic backend-only authorization seam; exact header semantics require the ACRA contract
ACRA_AUTH_HEADER_NAME=
ACRA_AUTH_HEADER_VALUE=
# Dedicated official API Marketplace Mock token-client inputs. They are required only
# when that explicit mode is selected; populating them alone does not activate it.
ACRA_API_MARKETPLACE_MOCK_CLIENT_ID=
ACRA_API_MARKETPLACE_MOCK_SECRET_KEY=
ACRA_LIVE_SMOKE_ENABLED=false
ACRA_SMOKE_UEN=

# Connector modes. GoldTier `sandbox` means the Partial XPI lane, never Live.
# The normal sponsor IDP is bounded local PDF/DOCX/TXT text extraction; mock remains
# available only for developer/test fault injection.
ACRA_CONNECTOR_MODE=mock
# Official Marketplace Mock automatically uses the exact eligible Garden LOCAL fixture.
# D-112: GARDEN_SUPPLEMENT_ENABLED now controls the legacy flattened Garden fixture on the
# official Marketplace Mock lane (explicit opt-in, default off). Garden's normal happy path
# is the reviewed creator declaration bound to its client document.
# hybrid_direct_overlay (official Marketplace Mock lane only) replaces that flattened
# fixture with the whitelisted D-077 direct-holder overlays (Garden direct, five-layer
# demo): LOCAL_SYNTHETIC_RELATIONSHIP links, cache-first official issuer lookups,
# always review-required. Never Live evidence and never a provider fallback.
ACRA_MARKETPLACE_OWNERSHIP_OVERLAY=garden_legacy_supplement
# Official Mock lane switch (owner O5, 2026-11-01; never per company): accept_eligible_poc
# accepts an analysis whose only open causes are the code-level evidence POC basis
# (complete single-class current units, descriptive officer roles) or, in
# hybrid_direct_overlay, its scenario's declared assumptions, at the readiness boundary
# without manual verification. It stays review-classified and GoldTier confirmation is
# still required. Sandbox/Live never qualify. Default accept_eligible_poc.
ACRA_MARKETPLACE_POC_OWNERSHIP_ACCEPTANCE=accept_eligible_poc
# D-086 (hybrid_direct_overlay only): which whitelisted scenario the OPQ root (201511222D)
# uses. five_layer_simulation (default) is the historical D-077 demo; garden_sim_lim_chain
# is OPQ -> GARDEN BUSINESS (owner-declared 100%) -> SIM LIM; garden_abc_multi_holder (D-089)
# is OPQ -> GARDEN BUSINESS 50% and ABC COMPANY 50% (owner-declared), with ABC's holder from
# its official businessProfile issued capital (D-088). Operator choice only.
ACRA_MARKETPLACE_OPQ_SCENARIO=five_layer_simulation
GOLDTIER_CONNECTOR_MODE=mock
IDP_CONNECTOR_MODE=local_pdf_text
OWNERSHIP_CONNECTOR_MODE=mock

# Phase 03 project safety defaults; not sponsor-approved policy
IDP_MAX_UPLOAD_BYTES=5242880
IDP_MAX_FILES_PER_CASE=20
IDP_MAX_TOTAL_INTAKE_BYTES=26214400
IDP_REVIEW_CONFIDENCE_THRESHOLD=0.85

# Phase 04 project-defined provisional ownership policy and graph limits (pending Q-004)
UBO_OWNERSHIP_THRESHOLD_PERCENT=25
OWNERSHIP_MAX_PARTIES=100
OWNERSHIP_MAX_RELATIONSHIPS=200
OWNERSHIP_MAX_DEPTH=8
OWNERSHIP_MAX_PATHS_PER_CANDIDATE=64
OWNERSHIP_MAX_TOTAL_PATHS=256
