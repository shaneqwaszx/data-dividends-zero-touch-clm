{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git stash*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git stash*)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh api *merge*)",
      "mcp__plugin_github_github__merge_pull_request"
    ],
    "ask": [
      "Read(/private/**)",
      "Edit(/private/**)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(git worktree add*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(gh pr create*)",
      "Bash(gh pr review*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr close*)",
      "Bash(gh pr ready*)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(gh run cancel*)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)",
      "PowerShell(git reset*)",
      "PowerShell(git checkout*)",
      "PowerShell(git switch*)",
      "PowerShell(git restore*)",
      "PowerShell(git branch -d*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git branch --delete*)",
      "PowerShell(git worktree add*)",
      "PowerShell(git worktree remove*)",
      "PowerShell(git worktree prune*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr review*)",
      "PowerShell(gh pr edit*)",
      "PowerShell(gh pr comment*)",
      "PowerShell(gh pr close*)",
      "PowerShell(gh pr ready*)",
      "PowerShell(gh workflow run*)",
      "PowerShell(gh run rerun*)",
      "PowerShell(gh run cancel*)"
    ],
    "allow": [
      "Bash(python scripts/dev_context.py *)",
      "PowerShell(python scripts/dev_context.py *)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "PowerShell(.\\.venv\\Scripts\\python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m ruff check *)",
      "PowerShell(.\\.venv\\Scripts\\python.exe -m ruff check *)",
      "Bash(.venv/Scripts/python.exe -m mypy *)",
      "PowerShell(.\\.venv\\Scripts\\python.exe -m mypy *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git worktree list*)"
    ]
  }
}
